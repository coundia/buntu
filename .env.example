# Default API keys for this build (PRD 28). Copy to `.env` (git-ignored) and fill in what you have.
# Environment variables with the same names take precedence over this file.
# Only service API keys belong here: never a password, a personal account or a source URL.
# A user's own key (Settings) always wins over these. Run `task keys` to regenerate.

# --- Metadata (free, quota-limited, revocable) ---------------------------------------------------
# https://www.omdbapi.com/apikey.aspx
CND_OMDB_API_KEY=
# https://www.themoviedb.org/settings/api (used by the saga collections, PRD 27)
CND_TMDB_API_KEY=

# --- Subtitles -----------------------------------------------------------------------------------
# OpenSubtitles *application* key (https://www.opensubtitles.com/consumers), not a user account.
CND_OPENSUBTITLES_API_KEY=

# --- Assistant IA (PRD 13) -----------------------------------------------------------------------
# Provider offered by default when the user has not chosen one: gemini | openai | anthropic | none
CND_DEFAULT_AI_PROVIDER=none
CND_GEMINI_API_KEY=
CND_OPENAI_API_KEY=
CND_OPENAI_BASE_URL=https://api.openai.com/v1
CND_OPENAI_MODEL=
CND_ANTHROPIC_API_KEY=

# --- Release builds ------------------------------------------------------------------------------
# Debug builds embed every key present. Release builds embed only what is enabled here.
# Any key embedded in a distributed app can be extracted: keep AI keys out of distributed builds,
# or use a dedicated key with a spending cap at the provider.
CND_EMBED_METADATA_KEYS_IN_RELEASE=1
CND_EMBED_AI_KEYS_IN_RELEASE=0
